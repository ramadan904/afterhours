{
  "name": "afterhours",
  "version": "0.2.0",
  "description": "Afterhours: an Alexa+ MCP server for tokenized stocks, for the hours the stock market is closed.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "node dist/src/node.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "conformance": "tsx scripts/conformance.ts",
    "token": "tsx scripts/mint-token.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/curves": "^2.4.0",
    "bs58": "^6.0.0",
    "qrcode-generator": "^1.4.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
