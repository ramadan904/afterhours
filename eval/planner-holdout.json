   "tool": "check_stock",
   "args": {
    "stock": "AMZN"
   }
  },
  {
   "say": "Give me a quote on Meta",
   "tool": "check_stock",
   "args": {
    "stock": "META"
   }
  },
  {
   "say": "Tesla?",
   "tool": "check_stock",
   "args": {
    "stock": "TSLA"
   }
  },
  {
   "say": "What's my balance?",
   "tool": "my_portfolio"
  },
  {
