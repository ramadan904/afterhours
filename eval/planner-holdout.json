   "tool": "how_did_the_open_go",
   "args": {
    "stock": "TSLA"
   }
  },
  {
   "say": "Recap my week",
   "tool": "weekly_recap"
  },
  {
   "say": "What's the difference between the token and the share?",
   "tool": "explain",
   "args": {
    "topic": "price_gap"
   }
  },
  {
   "say": "Change my PIN",
   "tool": "set_trade_pin"
  },
  {
   "say": "Send me the news every morning at 8",
   "tool": "schedule_briefing",
   "args": {
    "time": "8"
   }
  }
 ]
