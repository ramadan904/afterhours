   "tool": "recurring_buy",
   "args": {
    "stock": "SPY",
    "amount_usd": 50,
    "cadence": "monthly",
    "day": "15"
   }
  },
  {
   "say": "Buy 10 dollars of Microsoft weekly",
   "tool": "recurring_buy",
   "args": {
    "stock": "MSFT",
    "amount_usd": 10,
    "cadence": "weekly"
   }
  },
  {
   "say": "Am I making money on Apple?",
   "tool": "my_returns",
   "args": {
    "stock": "AAPL"
   }
  },
  {
   "say": "Is there enough liquidity in Tesla for a big order?",
   "tool": "market_depth",
   "args": {
    "stock": "TSLA"
   }
  },
  {
   "say": "Split me 70 S&P 30 gold",
   "tool": "set_target_allocation",
   "args": {
