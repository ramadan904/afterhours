   "tool": "set_timezone",
   "args": {
    "place": "singapore"
   }
  },
  {
   "say": "Follow AMD",
   "tool": "edit_watchlist",
   "args": {
    "add": [
     "AMD"
    ]
   }
  },
  {
   "say": "Take Walmart off my watchlist",
   "tool": "edit_watchlist",
   "args": {
    "remove": [
     "WMT"
    ]
   }
  },
  {
