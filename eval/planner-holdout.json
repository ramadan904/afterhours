   "tool": "set_alert",
   "args": {
    "stock": "NVDA",
    "price": 190
   }
  },
  {
   "say": "Let me know when Palantir moves 4 percent",
   "tool": "set_alert",
   "args": {
    "stock": "PLTR",
    "percent": 4
   }
  },
  {
   "say": "Which alerts are set?",
   "tool": "list_alerts"
  },
  {
