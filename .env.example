# Public HTTPS origin of this deployment. Used as the OAuth issuer and to build
# the MCP resource URI (<PUBLIC_URL>/mcp), so it must match what clients call.
# Defaults to the platform's URL on Render (RENDER_EXTERNAL_URL) and Vercel.
PUBLIC_URL=https://afterhours.example.com

# At least 32 random characters. Signs access tokens. `openssl rand -base64 48`
AUTH_SECRET=

# "sample" serves the built-in offline board and portfolio instead of live data.
# AFTERHOURS_DATA=sample

# Live data sources (defaults shown).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_ENDPOINT=https://lite-api.jup.ag

# Alexa+ account linking: the client credentials and redirect URLs you enter on
# / copy from the add-on's account-linking page.
# ALEXA_CLIENT_ID=
# ALEXA_CLIENT_SECRET=
# ALEXA_REDIRECT_URIS=https://pitangui.amazon.com/api/skill/link/XXXX,https://layla.amazon.com/api/skill/link/XXXX,https://alexa.amazon.co.jp/api/skill/link/XXXX

# Shared state for serverless deployments (Upstash / Vercel KV). In memory otherwise.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Simulator planner: Claude on Amazon Bedrock when AWS credentials are present.
# AWS_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-opus-5-5
# PLANNER=scripted          # force the deterministic planner

# Voice trade cap and swap slippage.
# MAX_TRADE_USD=500
# TRADE_SLIPPAGE_BPS=50

# Send WWW-Authenticate on 401 for generic MCP clients (Alexa+ asks for none).
# WWW_AUTHENTICATE=on
